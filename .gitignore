# --- Project secrets / credentials ---
.env
.env.*
*.key
*.pem
service-account*.json
credentials*.json
.logfire/logfire_credentials.json
.streamlit/secrets.toml

# --- Terraform: state contains secrets in plaintext, tfvars ARE secrets ---
*.tfvars
!*.tfvars.example
*.tfstate
*.tfstate.*
.terraform/
# Saved plan files embed RESOLVED variable values -- including every sensitive
# one -- and they are binary, so text-based secret scanning does not see them.
tfplan
*.tfplan
plan.out
.terraform.tfstate.lock.info
crash.log
crash.*.log

# --- This project's virtual environment ---
noisegate_venv/

# --- Node / React frontend ---
# node_modules is 71 MB of reinstallable dependencies; package-lock.json is the
# thing worth versioning, since `npm ci` reproduces the tree exactly from it.
node_modules/
web/dist/
.vite/
npm-debug.log*
yarn-error.log*

